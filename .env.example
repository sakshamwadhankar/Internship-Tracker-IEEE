# Firebase Configuration
# Get these values from: https://console.firebase.google.com → Project Settings → General → Web App
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# One-tap sync (optional) — URL of your deployed Cloudflare Worker that
# dispatches the GitHub sync workflow. See README "One-tap sync".
# Without it, the Sync button opens the GitHub Actions page instead.
VITE_SYNC_TRIGGER_URL=
